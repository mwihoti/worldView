# Hashnode GraphQL API
NEXT_PUBLIC_HASHNODE_ENDPOINT=https://gql.hashnode.com
# Your Hashnode publication id (Hashnode dashboard -> your blog -> the id in the URL)
NEXT_PUBLIC_HASHNODE_PUBLICATION_ID=

# Optional: the public RSS feed used as a free fallback when the GraphQL API is unavailable
# NEXT_PUBLIC_HASHNODE_RSS_URL=https://worldview.hashnode.dev/rss.xml

# Optional: the canonical URL of the deployed site (used for SEO metadata, sitemap and RSS)
# NEXT_PUBLIC_SITE_URL=https://example.com

# --- Payload CMS (admin panel at /admin) ---

# Secret used to sign admin auth tokens. Required in production - generate with:
#   openssl rand -hex 32
PAYLOAD_SECRET=

# Database for the CMS. Leave unset for local dev (SQLite file worldview.db).
# In production use a Postgres connection string (e.g. a free Neon database):
# DATABASE_URI=postgres://user:pass@host/db?sslmode=require

# Media uploads. Local dev writes files to ./media. On Vercel the filesystem is
# read-only, so uploads go to UploadThing (https://uploadthing.com, free tier,
# no card). Create an app there, copy its token, and set it in Vercel too.
# UPLOADTHING_TOKEN=

# NVIDIA API key for the "Draft with AI" feature and the AI assistant panel.
# Get one at https://build.nvidia.com - without it (and without GEMINI_API_KEY
# below) AI features are disabled; the rest of the admin still works.
# NVIDIA_API_KEY=nvapi-...
# Optional: pick a different model from the NVIDIA catalog
# NVIDIA_MODEL=openai/gpt-oss-20b
# Optional: any OpenAI-compatible chat completions URL (used by tests/mocks)
# NVIDIA_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions

# Optional backstop provider: NVIDIA's free community models are occasionally
# slow or unavailable. When set, Gemini (Google AI Studio, also free on the
# Flash tier) is tried only if every NVIDIA attempt fails - it costs nothing
# extra when NVIDIA is working normally. Get a free key at
# https://aistudio.google.com/apikey. Works standalone too, if you'd rather
# skip NVIDIA_API_KEY entirely.
# GEMINI_API_KEY=...
# Optional: pick a different Gemini model
# GEMINI_MODEL=gemini-3.8-flash
